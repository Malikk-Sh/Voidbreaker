{
  "name": "voidbreaker",
  "version": "0.1.0",
  "private": true,
  "description": "VOIDBREAKER — mobile web action slasher. 100% procedural: graphics, animation, UI, music and SFX are generated by code.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "editor": "vite --open /editor.html",
    "studio-test": "node scripts/studio.mjs",
    "finishers": "node scripts/finishers.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "sweep": "node scripts/sweep.mjs",
    "spectacle": "node scripts/spectacle.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/philosopher": "^5.3.0",
    "@fontsource/tektur": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "playwright": "^1.56.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
